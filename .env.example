PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/contests
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
LOG_LEVEL=info

# anthropic | mock   (mock needs no key and is what the tests use)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# background job that closes ended contests and awards prizes
FINALIZER_INTERVAL_MS=60000

# rate limits (requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AI_MAX=10
