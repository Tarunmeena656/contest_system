    {
      "name": "4 Admin",
      "description": "Manages contests and questions, generates questions with AI, changes roles and finalizes contests. Admins can also join and play like any user.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{adminToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me"
          },
