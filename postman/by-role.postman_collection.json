{
  "info": {
    "_postman_id": "5b8e21c4-contest-by-role",
    "name": "Contest System - by role",
    "description": "One folder per role. Run the folders top to bottom (or the whole collection with the Runner): folder 0 signs in as every role and stores the tokens in collection variables, each later folder uses its own token.\n\nRoles:\n- Guest: browse contests, leaderboards, natural-language search.\n- User: + join and play normal contests, own result/history/in-progress/prizes.\n- VIP: + VIP-only contests.\n- Admin: + create/edit/delete contests, add or generate questions, change roles, finalize.\n\nNeeds the API running with the seed data (npm run migrate && npm run seed). No environment file required; baseUrl is a collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 Setup - sign in as each role (run first)",
      "description": "Gets a token for every role. Admin is seeded. The normal user and the VIP are registered fresh on every run so the walkthrough can be repeated (a user may submit a contest only once).\n\nSeeded accounts if you prefer them: admin@contest.dev / Admin123!, vip@contest.dev / Vip12345!, user@contest.dev / User1234!",
      "item": [
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@contest.dev\",\n  \"password\": \"Admin123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register a fresh normal user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "auth": {
              "type": "noauth"
            },
            "description": "Anyone can register. New accounts always get the role \"user\".",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Normal User\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('userEmail', 'user-' + Date.now() + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('userToken', pm.response.json().token);",
                  "pm.collectionVariables.set('userId', pm.response.json().user.id);",
                  "pm.test('new accounts are role user', () => pm.expect(pm.response.json().user.role).to.eql('user'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register a user who will become VIP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"VIP User\",\n  \"email\": \"{{vipEmail}}\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('vipEmail', 'vip-' + Date.now() + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('vipUserId', pm.response.json().user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin promotes that user to VIP",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/{{vipUserId}}/role",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Only an admin can change roles. Allowed values: user, vip, admin.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"vip\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('role is now vip', () => pm.expect(pm.response.json().role).to.eql('vip'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as the new VIP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "description": "A token carries the role it was issued with, so after a promotion the user signs in again to get a VIP token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{vipEmail}}\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('vipToken', pm.response.json().token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 Guest (no token)",
