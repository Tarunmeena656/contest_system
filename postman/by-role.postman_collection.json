        {
          "name": "List contests",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/contests",
            "description": "Everyone sees every contest. can_participate tells the caller whether they could join; for a guest it is always false. This request also remembers the ids of the seeded normal and VIP contests for the next folders."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const items = pm.response.json().items;",
                  "const normal = items.find((c) => c.name === 'JavaScript Basics') || items.find((c) => c.status === 'active' && c.access_level === 'normal');",
                  "const vip = items.find((c) => c.name === 'Node.js Backend Challenge') || items.find((c) => c.status === 'active' && c.access_level === 'vip');",
                  "if (normal) pm.collectionVariables.set('contestId', normal.id);",
                  "if (vip) pm.collectionVariables.set('vipContestId', vip.id);",
                  "pm.test('guest cannot participate anywhere', () => pm.expect(items.every((c) => c.can_participate === false)).to.be.true);"
                ]
              }
            }
          ]
        },
