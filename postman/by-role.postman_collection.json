          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const qs = pm.response.json().questions;",
                  "qs.forEach((q, i) => pm.collectionVariables.set('q' + (i + 1), q.id));",
                  "pm.test('correct answers are not exposed', () => pm.expect(qs.every((q) => q.correct_answers === undefined)).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit answers",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/contests/{{contestId}}/submit",
            "description": "One submission per user per contest. The last answer is wrong on purpose, so expect 3 of 4. Multi-select must match the full set; a partial match scores 0 for that question.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [\n    {\n      \"questionId\": \"{{q1}}\",\n      \"selected\": [\n        \"\\\"object\\\"\"\n      ]\n    },\n    {\n      \"questionId\": \"{{q2}}\",\n      \"selected\": [\n        \"String\",\n        \"Number\",\n        \"Symbol\"\n      ]\n    },\n    {\n      \"questionId\": \"{{q3}}\",\n      \"selected\": [\n        \"True\"\n      ]\n    },\n    {\n      \"questionId\": \"{{q4}}\",\n      \"selected\": [\n        \"pop\"\n      ]\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('scored 3 of 4', () => { const r = pm.response.json(); pm.expect(r.score).to.eql(3); pm.expect(r.maxScore).to.eql(4); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit again (409 ALREADY_SUBMITTED)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
