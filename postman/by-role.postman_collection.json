        {
          "name": "Create a contest",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/contests",
            "description": "start_time / end_time decide the status (upcoming, active, ended). The pre-request script makes it active now and open for a day.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Admin Contest\",\n  \"description\": \"Created from the by-role collection.\",\n  \"access_level\": \"normal\",\n  \"difficulty\": \"advanced\",\n  \"tags\": [\n    \"postman\",\n    \"backend\"\n  ],\n  \"prize\": \"Rs 2,000 voucher\",\n  \"start_time\": \"{{startTime}}\",\n  \"end_time\": \"{{endTime}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const now = Date.now();",
                  "pm.collectionVariables.set('startTime', new Date(now - 60 * 1000).toISOString());",
                  "pm.collectionVariables.set('endTime', new Date(now + 24 * 60 * 60 * 1000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('adminContestId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
